# ==================================================
# CareerLink - Root Environment Configuration Example
# ==================================================
# Used by docker-compose and local multi-service runners

PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/careerlink
JWT_SECRET=provide_a_strong_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
