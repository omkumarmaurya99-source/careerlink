{
  "name": "careerlink-backend",
  "version": "1.0.0",
  "description": "CareerLink - Job Portal Backend API built with Node.js, Express, MongoDB, and Firebase",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles --testTimeout=30000",
    "test:coverage": "jest --forceExit --detectOpenHandles --coverage --testTimeout=30000",
    "lint": "echo 'No lint configured'"
  },
  "keywords": ["job-portal", "careerlink", "express", "mongodb", "firebase"],
  "author": "Om Maurya",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "firebase-admin": "^12.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.14.2",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.8.0",
    "yaml": "^2.5.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "testTimeout": 30000,
    "verbose": true
  }
}
