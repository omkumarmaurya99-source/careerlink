                "resume",
                "upload"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Validates resume upload correctly\", function () {",
                  "  // If executed in automated runner without manual file attachment, expect 400 Bad Request",
                  "  // If executed with actual attached PDF/DOCX file, expect 200 OK",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
