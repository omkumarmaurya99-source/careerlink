# ==================================================
# CareerLink Backend - Environment Variables
# ==================================================
# Yeh file environment variables ka example hai
# Isko copy karke .env banao aur apni values dalo

# Server Configuration
# Note: On macOS, Port 5000 is used by AirPlay/ControlCenter, so 5001 is default
PORT=5001
NODE_ENV=development

# MongoDB Configuration
# MongoDB Atlas ya local MongoDB ka connection string
MONGODB_URI=mongodb://localhost:27017/careerlink

# JWT Configuration
# JWT secret key - production mein strong random string use karo
JWT_SECRET=replace_with_a_unique_random_secret_before_deployment
JWT_EXPIRES_IN=7d

# Firebase Admin SDK Configuration (Choose Method 1 or Method 2)
# Method 1: Individual Environment Variables (Best for Cloud/Docker/Render/Vercel)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace_with_your_firebase_private_key

# Method 2: Service Account JSON File Path (Alternative for local dev)backend/.env
# FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# Firebase Storage Bucket (Optional)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# CORS Configuration
# Frontend URL jo backend se connect hoga
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
