# ==================================================
# CareerLink Frontend - Environment Variables Example
# ==================================================
# Copy this file to .env and provide your actual Firebase Client SDK keys

# Backend API Base URL
VITE_API_URL=http://localhost:5001/api

# Firebase Client SDK Configuration (From Firebase Console > Project Settings > Web App)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere123456
VITE_FIREBASE_AUTH_DOMAIN=careerlink-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=careerlink-portal
VITE_FIREBASE_STORAGE_BUCKET=careerlink-portal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
