# Dependencies
node_modules/
*/node_modules/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
firebase-service-account*.json
firebase.json
backend/src/config/firebase.json
*.pem
*.key

# User Uploads (preserve folder structure with .gitkeep)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# Build artifacts
dist/
build/
frontend/dist/

# OS specific files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Allow example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example
